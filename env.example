# Required
DA_USER_ID=
DA_ACCESS_TOKEN=
AMQP_DSN=amqp://user:password@localhost:5672

# Optional
DA_LOG_LEVEL=INFO
DA_API_BASE=https://www.donationalerts.com/api/v1
DA_WS_URL=wss://centrifugo.donationalerts.com/connection/websocket
DA_RECONNECT_MAX_DELAY=30
DA_HEARTBEAT_PATH=/tmp/redonats.heartbeat
AMQP_QUEUE=donations
AMQP_RECONNECT_DELAY=5.0
